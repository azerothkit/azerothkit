{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azerothkit",
  "version": "0.1.0",
  "identifier": "com.0zd0.azerothkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Azerothkit",
        "width": 550,
        "height": 800,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "preventOverflow": true,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#000",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
    "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/macos/icon.icns",
      "icons/macos/compiled/Assets.car",
      "icons/icon.ico"
    ]
  }
}